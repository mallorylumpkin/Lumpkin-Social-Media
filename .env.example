# Copy to .env.local and fill in from Supabase: Project Settings > API.
# Both values below are safe to expose to the browser (the anon/publishable key is protected by Row Level Security).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only values are added in later phases (never prefix these with NEXT_PUBLIC_):
# SUPABASE_SERVICE_ROLE_KEY=
# AI_PROVIDER_API_KEY=
